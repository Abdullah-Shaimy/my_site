# ==============================================================================
# Portfolio Website Environment Variables (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Configuration
# ------------------------------------------------------------------------------
# Canonical base URL for the site (used for SEO, sitemaps, robots.txt, and PayHere return/notify URLs)
# Local development: http://localhost:3000
# Production: https://abdullahshaimy.lk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Database & Auth Configuration
# ------------------------------------------------------------------------------
# Found in: Supabase Dashboard -> Project Settings -> API
# Required for contact forms, payments records, user auth profiles, and mail logs
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 3. Resend Transactional Mail Service
# ------------------------------------------------------------------------------
# Found in: https://resend.com/api-keys
# Required for dispatching emails through app/lib/mailActions.ts
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 4. PayHere Payment Gateway (Sri Lanka)
# ------------------------------------------------------------------------------
# Found in: PayHere Merchant Portal (https://www.payhere.lk/)
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_SECRET=your_payhere_merchant_secret

# PayHere Mode: "sandbox" (for local testing) or "live" (for real transactions)
PAYHERE_ENV=sandbox
NEXT_PUBLIC_PAYHERE_ENV=sandbox
